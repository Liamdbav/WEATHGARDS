# ============================================================
# WEATHGARDS — environment configuration template
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
# Interface the FastAPI/uvicorn server binds to.
# Use 0.0.0.0 only when the LLM client is on the same subnet.
WEATHGARDS_HOST=127.0.0.1
WEATHGARDS_PORT=8765
# "development" | "production"
WEATHGARDS_ENV=development

# ------------------------------------------------------------
# Security — shared secret for MCP network transport
# All requests to /mcp/* must carry:  Authorization: Bearer <TOKEN>
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
WEATHGARDS_MCP_TOKEN=CHANGE_ME_generate_a_random_token

# Optional: comma-separated list of allowed client IPs / CIDR blocks.
# Empty = allow any client that presents the correct token.
# Example: 192.168.1.0/24,10.0.0.5
WEATHGARDS_ALLOWED_CLIENTS=

# ------------------------------------------------------------
# Docker scanner
# ------------------------------------------------------------
# Override only if your Docker socket is at a non-standard path.
# Leave empty to let the SDK auto-detect (Unix socket / Windows named pipe).
WEATHGARDS_DOCKER_HOST=

# Timeout (seconds) for Docker API calls
WEATHGARDS_DOCKER_TIMEOUT=10

# ------------------------------------------------------------
# Process / service scanner
# ------------------------------------------------------------
# Comma-separated process name patterns to include in scans.
# Empty = include everything (filtered later via activation).
WEATHGARDS_PROCESS_INCLUDE_PATTERNS=

# Interval (seconds) between automatic background scans
WEATHGARDS_SCAN_INTERVAL=30

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# "DEBUG" | "INFO" | "WARNING" | "ERROR"
WEATHGARDS_LOG_LEVEL=INFO
# "json" | "console"  (json recommended for production)
WEATHGARDS_LOG_FORMAT=console

# ------------------------------------------------------------
# Frontend static files
# ------------------------------------------------------------
# Path to the built React/Vite bundle that FastAPI serves.
# Relative to the project root, or absolute.
# Default: frontend/dist
WEATHGARDS_STATIC_DIR=frontend/dist
# ---------------------------------------------------------------------------
# TLS — Certificat autosigné pour HTTPS sur le serveur MCP (optionnel)
# Générer avec :
#   openssl req -x509 -newkey rsa:4096 -nodes \
#     -keyout certs/weathgards.key -out certs/weathgards.crt -days 825 \
#     -subj "/CN=weathgards-local" \
#     -addext "subjectAltName=IP:127.0.0.1,DNS:localhost"
# ---------------------------------------------------------------------------
WEATHGARDS_TLS_CERT_FILE=
WEATHGARDS_TLS_KEY_FILE=
